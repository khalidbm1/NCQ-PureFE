{
  "name": "@ncq/frontend",
  "version": "1.0.0",
  "description": "NCQ Frontend Monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "lerna run dev --parallel",
    "build": "lerna run build",
    "build:all": "lerna run build --stream",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:coverage": "jest --coverage",
    "lint": "lerna run lint",
    "type-check": "lerna run type-check",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "clean": "lerna run clean && rm -rf node_modules",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "analyze": "ANALYZE=true lerna run build",
    "e2e": "cypress open",
    "e2e:headless": "cypress run",
    "affected:apps": "nx affected:apps",
    "affected:libs": "nx affected:libs",
    "affected:build": "nx affected:build",
    "affected:e2e": "nx affected:e2e",
    "affected:test": "nx affected:test",
    "affected:lint": "nx affected:lint",
    "affected:dep-graph": "nx affected:dep-graph",
    "affected": "nx affected",
    "dep-graph": "nx dep-graph",
    "workspace-generator": "nx workspace-generator",
    "help": "nx help"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "next": "^14.0.0",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.6.0",
    "react-hook-form": "^7.48.0",
    "yup": "^1.3.0",
    "@hookform/resolvers": "^3.3.0",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.4.0",
    "date-fns": "^2.30.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "@radix-ui/react-slot": "^1.0.2",
    "react-hot-toast": "^2.4.0",
    "next-themes": "^0.2.1",
    "lucide-react": "^0.290.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@nrwl/cli": "^17.0.0",
    "@nrwl/cypress": "^17.0.0",
    "@nrwl/eslint-plugin-nx": "^17.0.0",
    "@nrwl/jest": "^17.0.0",
    "@nrwl/linter": "^17.0.0",
    "@nrwl/next": "^17.0.0",
    "@nrwl/react": "^17.0.0",
    "@nrwl/storybook": "^17.0.0",
    "@nrwl/vite": "^17.0.0",
    "@nrwl/web": "^17.0.0",
    "@nrwl/workspace": "^17.0.0",
    "@storybook/addon-essentials": "^7.5.0",
    "@storybook/react-vite": "^7.5.0",
    "@swc/cli": "^0.1.63",
    "@swc/core": "^1.3.100",
    "@testing-library/react": "^14.1.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@testing-library/react-hooks": "^8.0.1",
    "jest-watch-typeahead": "^2.2.2",
    "jest-environment-jsdom": "^29.7.0",
    "babel-jest": "^29.7.0",
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.23.0",
    "identity-obj-proxy": "^3.0.0",
    "eslint-plugin-testing-library": "^6.0.0",
    "eslint-plugin-jest-dom": "^5.0.0",
    "lerna": "^7.4.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "cypress": "^13.6.0",
    "eslint": "^8.55.0",
    "eslint-config-next": "^14.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^2.15.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "nx": "^17.0.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.3.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
}