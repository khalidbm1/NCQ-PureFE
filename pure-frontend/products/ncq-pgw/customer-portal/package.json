    "@headlessui/vue": "^1.7.19",
    "@heroicons/vue": "^2.1.3",
    "vue-i18n": "^9.10.2",
    "vue-toastification": "^2.0.0-rc.5",
    "chart.js": "^4.4.2",
    "vue-chartjs": "^5.3.1",
    "date-fns": "^3.6.0",
    "vee-validate": "^4.12.6",
    "@vee-validate/yup": "^4.12.6",
    "yup": "^1.4.0",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/tsconfig": "^0.5.1",
    "typescript": "~5.4.0",
    "vue-tsc": "^2.0.6",
    "vite": "^5.2.8",
    "vitest": "^1.4.0",
    "@vitest/ui": "^1.4.0",
    "@vue/test-utils": "^2.4.5",
    "jsdom": "^24.0.0",
    "eslint": "^8.57.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "eslint-plugin-vue": "^9.23.0",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.3",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "@tailwindcss/forms": "^0.5.7",
