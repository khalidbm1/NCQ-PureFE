    "type-check": "tsc --noEmit",
    "chromatic": "npx chromatic --project-token=<CHROMATIC_PROJECT_TOKEN>",
    "design-tokens": "style-dictionary build",
    "prepare": "npm run build"
  },
  "keywords": [
    "design-system",
    "react",
