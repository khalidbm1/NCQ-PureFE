{
  "name": "@ncq/build-config",
  "version": "1.0.0",
  "description": "Optimized build configuration for NCQ Platform with advanced code splitting and performance optimizations",
  "main": "index.js",
  "scripts": {
    "build:vite": "vite build --config vite.config.ts",
    "build:webpack": "webpack --mode production --config webpack.config.ts",
    "dev:vite": "vite --config vite.config.ts",
    "dev:webpack": "webpack serve --mode development --config webpack.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "analyze:vite": "ANALYZE=true vite build --config vite.config.ts",
    "analyze:webpack": "ANALYZE=true webpack --mode production --config webpack.config.ts",
    "build:federation": "MODULE_FEDERATION=true webpack --mode production --config webpack.config.ts",
    "build:legacy": "LEGACY_BUILD=true vite build --config vite.config.ts",
    "build:docker": "docker build -t ncq-platform .",
    "test:build": "npm run build:vite && npm run preview",
    "type-check": "tsc --noEmit",
    "lint:config": "eslint *.ts --fix"
  },
  "keywords": [
    "vite",
    "webpack",
    "build-optimization",
    "code-splitting",
    "performance",
    "ncq",
    "react",
    "typescript"
  ],
  "author": "NCQ Development Team",
  "license": "MIT",
  "devDependencies": {
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.11",
    "@swc/core": "^1.3.95",
    "@svgr/webpack": "^8.1.0",
    "@types/compression-webpack-plugin": "^10.1.0",
    "@types/copy-webpack-plugin": "^10.1.0",
    "@types/css-minimizer-webpack-plugin": "^3.2.0",
    "@types/html-webpack-plugin": "^3.2.9",
    "@types/mini-css-extract-plugin": "^2.5.1",
    "@types/node": "^20.8.0",
    "@types/terser-webpack-plugin": "^5.2.0",
    "@types/webpack": "^5.28.3",
    "@types/webpack-bundle-analyzer": "^4.6.0",
    "@types/webpack-dev-server": "^4.7.2",
    "@types/workbox-webpack-plugin": "^5.1.11",
    "@vitejs/plugin-legacy": "^4.1.1",
    "@vitejs/plugin-react-swc": "^3.4.0",
    "autoprefixer": "^10.4.16",
    "clean-webpack-plugin": "^4.0.0",
    "compression-webpack-plugin": "^10.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "cssnano": "^6.0.1",
    "eslint": "^8.51.0",
    "fork-ts-checker-webpack-plugin": "^9.0.0",
    "html-webpack-plugin": "^5.5.3",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.4.31",
    "postcss-loader": "^7.3.3",
    "react-dev-utils": "^12.0.1",
    "rollup-plugin-visualizer": "^5.9.2",
    "sass": "^1.69.4",
    "sass-loader": "^13.3.2",
    "style-loader": "^3.3.3",
    "swc-loader": "^0.2.3",
    "tailwindcss": "^3.3.5",
    "terser-webpack-plugin": "^5.3.9",
    "typescript": "^5.2.2",
    "vite": "^4.5.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-dynamic-import": "^1.5.0",
    "vite-plugin-html": "^3.2.0",
    "vite-plugin-pwa": "^0.16.7",
    "vitest": "^0.34.6",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.9.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "workbox-webpack-plugin": "^7.0.0"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.0",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "files": [
    "vite.config.ts",
    "webpack.config.ts",
    "postcss.config.js",
    "tailwind.config.js",
    "tsconfig.build.json",
    "docker/",
    "scripts/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NCQ-sa/ncq-platform.git",
    "directory": "NCQ Platform/frontend/build-config"
  },
  "publishConfig": {
    "access": "restricted"
  }
}